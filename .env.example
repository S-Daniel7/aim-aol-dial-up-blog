NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical site URL — used for OG tags, sitemap.xml and robots.txt.
# MUST be set in production or those will point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only this email may sign in to /admin (login fails closed if unset)
ADMIN_EMAIL=you@example.com

# Now-playing widget (optional). Visit /api/spotify/auth once to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Display name on the /live feed (public)
NEXT_PUBLIC_LIVE_FEED_AUTHOR=your name

# Your screen name — right-aligned in chat logs by default (public)
NEXT_PUBLIC_SCREEN_NAME=soapie

# Weather note location (public). Defaults to NYC if unset.
NEXT_PUBLIC_WEATHER_LAT=40.71
NEXT_PUBLIC_WEATHER_LON=-74.01
NEXT_PUBLIC_WEATHER_CITY=new york
